# OpenAI-compatible provider. This can be OmniRoute or any other provider.
BASE_URL=http://127.0.0.1:20128/v1
API_KEY=
MODEL_NAME=auto/best-chat

# Sentinel backend/extension shared secret.
SENTINEL_TOKEN=replace-with-a-long-random-local-secret

# Optional local tools.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
SENTINEL_DRY_RUN=0
