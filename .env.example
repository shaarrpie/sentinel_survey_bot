# OpenAI-compatible provider. This can be OmniRoute or any other provider.
BASE_URL=http://127.0.0.1:20128/v1
API_KEY=
MODEL_NAME=auto/best-chat

# Sentinel backend/extension shared secret.
# REQUIRED — the backend refuses to start without it, and every route
# except GET /status rejects requests that don't present it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_TOKEN=replace-with-a-long-random-local-secret

# Optional: pin your extension's ID (chrome://extensions) so CORS only
# accepts YOUR extension's pages. Without it the backend warns and accepts
# any well-formed chrome-extension origin.
SENTINEL_EXTENSION_ID=

# Optional local tools.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# SAFETY: 1 = the backend returns decisions but executes nothing (phantom
# hands). Start at 1 and only turn it off when you are pointing the bot at
# a form you control (e.g. survey-test.html).
SENTINEL_DRY_RUN=1

# Optional debug / trace tuning.
SENTINEL_DEBUG=0            # 1 = expose GET /debug/last (prompt + persona)
SENTINEL_TRACE=1            # 1 = archive each /decide as templates/trace-style HTML
SENTINEL_TRACE_KEEP=400     # max trace files
SENTINEL_TRACE_AGE_HOURS=72 # max trace age
SENTINEL_SNAP_MAX=1200      # screenshot b64 prefix kept in traces (0 = full)
